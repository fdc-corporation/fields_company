<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_fdc" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t>
                <div class="page fdc-purchase" style="font-family: Arial, sans-serif; font-size: 11px; color: #111;">
                    <style>
                        .fdc-purchase .brand-line {height: 8px; background: linear-gradient(90deg,#159dcc 0 24%,#111 24% 50%,#e41f2b 50% 75%,#111 75%); margin: -10mm -7mm 10px;}
                        .fdc-purchase .section-title {background:#f0f3f5; font-weight:700; font-size:13px; padding:5px 10px;}
                        .fdc-purchase .muted-row {background:#f0f3f5;}
                        .fdc-purchase table {width:100%; border-collapse:collapse;}
                        .fdc-purchase th {border-bottom:1px solid #111; padding:6px 5px; font-weight:700;}
                        .fdc-purchase td {padding:6px 5px; vertical-align:top;}
                        .fdc-purchase .lines tbody tr:nth-child(even) {background:#f0f3f5;}
                        .fdc-purchase .amount {text-align:right; white-space:nowrap;}
                        .fdc-purchase .footer {position:fixed; bottom:0; left:0; right:0; border-top:1px solid #111; padding-top:4px; font-size:9px;}
                    </style>

                    <div class="brand-line"/>
                    <table style="margin-bottom:16px;">
                        <tr>
                            <td style="width:35%;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-width:180px; max-height:75px;" alt="Logo"/>
                            </td>
                            <td style="width:35%; text-align:center; line-height:1.25;">
                                <strong t-field="o.company_id.name"/><br/>
                                <span t-field="o.company_id.street"/><br/>
                                <span><t t-esc="o.company_id.city or ''"/> <t t-esc="o.company_id.zip or ''"/></span><br/>
                                <em>Ofrecemos soluciones... Generamos confianza</em>
                            </td>
                            <td style="width:30%; text-align:center;">
                                <div class="section-title">Orden de Compra</div>
                                <strong>#<span t-field="o.name"/></strong><br/>
                                <strong>Fecha de Emisión: </strong>
                                <span t-field="o.date_order" t-options="{'widget':'date'}"/>
                            </td>
                        </tr>
                    </table>

                    <table style="margin-bottom:14px;">
                        <tr>
                            <td class="section-title" style="width:50%;">DIRECCIÓN DE ENVÍO</td>
                            <td class="section-title" style="width:50%;">INFORMACIÓN DEL PROVEEDOR</td>
                        </tr>
                        <tr>
                            <td>
                                <t t-set="shipping" t-value="o.dest_address_id or o.company_id.partner_id"/>
                                <strong t-field="shipping.name"/><br/>
                                <span t-field="shipping" t-options='{"widget":"contact","fields":["address","phone","vat"],"no_marker":true}'/>
                            </td>
                            <td>
                                <strong t-field="o.partner_id.name"/><br/>
                                <span t-field="o.partner_id" t-options='{"widget":"contact","fields":["address","phone","vat"],"no_marker":true}'/>
                                <strong>Condición de pago: </strong><span t-field="o.payment_term_id"/>
                            </td>
                        </tr>
                    </table>

                    <table class="muted-row" style="margin-bottom:14px;">
                        <tr>
                            <td style="width:50%;"><strong>COMPRADOR</strong><br/><span t-field="o.user_id"/></td>
                            <td style="width:25%;"><strong>FECHA DE ENTREGA</strong><br/><span t-field="o.date_planned" t-options="{'widget':'date'}"/></td>
                            <td style="width:25%;"><strong>MONEDA</strong><br/><span t-field="o.currency_id"/></td>
                        </tr>
                    </table>

                    <table class="lines">
                        <thead>
                            <tr>
                                <th style="text-align:left; width:51%;">Notas</th>
                                <th class="amount">Qty</th>
                                <th class="amount">Unit Price</th>
                                <th class="amount">Disc.</th>
                                <th class="amount">Taxes</th>
                                <th class="amount">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)" t-as="line">
                                <tr t-if="not line.display_type">
                                    <td><span t-field="line.name" style="white-space:pre-line;"/></td>
                                    <td class="amount"><span t-field="line.product_qty"/><br/><span t-field="line.product_uom_id"/></td>
                                    <td class="amount"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                                    <td class="amount"><span t-field="line.discount"/>%</td>
                                    <td class="amount"><span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/></td>
                                    <td class="amount"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                                </tr>
                                <tr t-elif="line.display_type in ('line_section','line_subsection')">
                                    <td colspan="6"><strong t-field="line.name"/></td>
                                </tr>
                                <tr t-else=""><td colspan="6"><em t-field="line.name"/></td></tr>
                            </t>
                        </tbody>
                    </table>

                    <div style="width:38%; margin-left:auto; margin-top:4px;">
                        <table class="muted-row">
                            <t t-call="purchase.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                            </t>
                        </table>
                    </div>
                    <div t-if="o.note" style="margin-top:14px;"><strong>Notas:</strong><br/><span t-field="o.note"/></div>

                    <div class="footer">
                        <table><tr>
                            <td style="width:33%;"><span t-esc="o.company_id.email or ''"/></td>
                            <td style="width:34%; text-align:center;"><span t-esc="o.company_id.website or ''"/><br/>Página <span class="page"/> / <span class="topage"/></td>
                            <td style="width:33%; text-align:right;"><span t-esc="o.company_id.phone or ''"/></td>
                        </tr></table>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
