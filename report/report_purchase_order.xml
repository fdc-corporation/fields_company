<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_fdc" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="shipping" t-value="o.dest_address_id or o.company_id.partner_id"/>
            <meta charset="utf-8"/>
            <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
            <div class="page fdc-purchase">
                <style>
                    .fdc-purchase {
                        position: relative;
                        min-height: 297mm;
                        padding: 0 5mm 14mm;
                        color: #080808;
                        font-family: Arial, 'DejaVu Sans', sans-serif;
                        font-size: 7px;
                        line-height: 1.18;
                    }
                    .fdc-purchase * { box-sizing: border-box; }
                    .fdc-purchase table { width: 100% !important; border-collapse: collapse; font-size: 7px !important; line-height: 1.16; }
                    .fdc-purchase .fdc-header { position: relative; height: 25mm; margin: 0 -5mm 2mm; }
                    .fdc-purchase .fdc-top-line {
                        display: block;
                        width: 100%;
                        height: 2mm;
                        object-fit: fill;
                    }
                    .fdc-purchase .fdc-brand-fallback {
                        width: 100%;
                        height: 2mm;
                        background: #248fbc;
                        border-right: 52mm solid #181818;
                        border-left: 52mm solid #236899;
                    }
                    .fdc-purchase .fdc-head { table-layout: fixed; margin: 2mm 5mm 0; width: calc(100% - 10mm) !important; }
                    .fdc-purchase .fdc-head td { border: 0 !important; padding: 0 2mm !important; vertical-align: top; }
                    .fdc-purchase .fdc-logo { max-width: 38mm; max-height: 17mm; object-fit: contain; }
                    .fdc-purchase .fdc-company {
                        text-align: center;
                        font-size: 7px;
                        line-height: 1.12;
                    }
                    .fdc-purchase .fdc-company-name { font-size: 7.5px; font-weight: 700; }
                    .fdc-purchase .fdc-docbox { text-align: center; font-size: 7px; }
                    .fdc-purchase .fdc-doc-title {
                        margin-bottom: 2mm;
                        padding: 1.5mm 1mm;
                        background: #eaf1f4;
                        font-size: 8px;
                        font-weight: 700;
                    }
                    .fdc-purchase .fdc-section-title {
                        padding: 1.1mm 1.6mm;
                        background: #eef1f3;
                        font-size: 7px;
                        font-weight: 700;
                        text-transform: uppercase;
                    }
                    .fdc-purchase .fdc-info { table-layout: fixed; margin-bottom: 2mm; }
                    .fdc-purchase .fdc-info td {
                        width: 50%;
                        padding: 1.2mm 1.6mm 0.8mm;
                        vertical-align: top;
                        font-size: 7px;
                        line-height: 1.16;
                    }
                    .fdc-purchase .fdc-label { font-weight: 700; }
                    .fdc-purchase .fdc-meta {
                        table-layout: fixed;
                        margin-bottom: 2mm;
                        background: #eef1f3;
                    }
                    .fdc-purchase .fdc-meta td {
                        padding: 1mm 1.8mm;
                        vertical-align: top;
                        font-size: 7px;
                        line-height: 1.16;
                    }
                    .fdc-purchase .fdc-lines {
                        table-layout: fixed;
                        font-size: 6.5px;
                        line-height: 1.14;
                    }
                    .fdc-purchase .fdc-lines th {
                        padding: 1mm 1.1mm;
                        border-bottom: 0.35mm solid #171717;
                        text-align: left;
                        font-size: 6.5px;
                        font-weight: 700;
                    }
                    .fdc-purchase .fdc-lines td {
                        padding: 1.2mm 1.1mm;
                        vertical-align: top;
                    }
                    .fdc-purchase .fdc-lines tbody tr:nth-child(even) { background: #eef1f3; }
                    .fdc-purchase .fdc-lines .fdc-section-line { background: #dfe5e8 !important; }
                    .fdc-purchase .fdc-number { text-align: right; white-space: nowrap; }
                    .fdc-purchase .fdc-description { white-space: pre-line; overflow-wrap: anywhere; }
                    .fdc-purchase .fdc-total-area {
                        position: relative;
                        width: 100%;
                        height: 18mm;
                        border-top: 0.35mm solid #171717;
                    }
                    .fdc-purchase .fdc-totals-wrap {
                        position: absolute;
                        top: 0;
                        right: 0;
                        width: 38% !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        background: #eef1f3;
                    }
                    .fdc-purchase .fdc-totals {
                        width: 100% !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        background: #eef1f3;
                    }
                    .fdc-purchase .fdc-totals td {
                        padding: 1.3mm 2mm;
                        font-size: 6.5px !important;
                        line-height: 1.15 !important;
                    }
                    .fdc-purchase .fdc-totals td *,
                    .fdc-purchase .fdc-totals strong,
                    .fdc-purchase .fdc-totals span {
                        font-size: 6.5px !important;
                        line-height: 1.15 !important;
                    }
                    .fdc-purchase .fdc-totals tr:last-child td {
                        color: #1388bc;
                        font-weight: 700;
                    }
                    .fdc-purchase .fdc-notes { margin-top: 2mm; font-size: 6.5px; }
                    .fdc-purchase .fdc-footer {
                        position: absolute;
                        right: 0;
                        bottom: 0;
                        left: 0;
                        height: 8mm;
                        padding-top: 1mm;
                        border-top: 0.3mm solid #111;
                        font-size: 6px;
                        line-height: 1.22;
                        background: #fff;
                    }
                    .fdc-purchase .fdc-footer td { width: 33.333%; padding: 0 !important; border: 0 !important; vertical-align: top; }
                </style>

                <div class="fdc-header">
                    <img t-if="o.report_top_line"
                         class="fdc-top-line"
                         t-att-src="image_data_uri(o.report_top_line)"
                         alt="Franja corporativa"/>
                    <div t-else="" class="fdc-brand-fallback"/>
                    <table class="fdc-head">
                    <colgroup>
                        <col style="width:30%;"/>
                        <col style="width:42%;"/>
                        <col style="width:28%;"/>
                    </colgroup>
                    <tr>
                        <td>
                            <img t-if="o.company_id.logo"
                                 class="fdc-logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 alt="FDC Corporation"/>
                        </td>
                        <td class="fdc-company">
                            <div class="fdc-company-name"><span t-out="o.report_clean_text(o.company_id.name)"/></div>
                            <div>
                                <span t-if="o.company_id.street" t-out="o.report_clean_text(o.company_id.street)"/>
                                <t t-if="o.company_id.street2">, <span t-out="o.report_clean_text(o.company_id.street2)"/></t>
                            </div>
                            <div>
                                <span t-if="o.company_id.city" t-out="o.report_clean_text(o.company_id.city)"/>
                                <t t-if="o.company_id.zip"> - <span t-field="o.company_id.zip"/></t>
                            </div>
                            <div t-if="o.company_id.vat">RUC: <span t-field="o.company_id.vat"/></div>
                            <div style="margin-top:1mm; font-style:italic;">Ofrecemos Soluciones... Generamos Confianza</div>
                        </td>
                        <td class="fdc-docbox">
                            <div class="fdc-doc-title">Orden de Compra</div>
                            <div style="font-weight:700;">#<span t-field="o.name"/></div>
                            <div style="margin-top:1.8mm;">
                                <span class="fdc-label">Fecha de Emision: </span>
                                <span t-field="o.date_order" t-options="{'widget':'date'}"/>
                            </div>
                        </td>
                    </tr>
                    </table>
                </div>

                <table>
                    <tr>
                        <td class="fdc-section-title" style="width:50%;">Direccion de envio</td>
                        <td class="fdc-section-title" style="width:50%;">Informacion del proveedor</td>
                    </tr>
                </table>
                <table class="fdc-info">
                    <tr>
                        <td>
                            <div class="fdc-label"><span t-out="o.report_clean_text(shipping.name)"/></div>
                            <div>
                                <span t-if="shipping.street" t-out="o.report_clean_text(shipping.street)"/>
                                <t t-if="shipping.street2">, <span t-out="o.report_clean_text(shipping.street2)"/></t>
                                <t t-if="shipping.city">, <span t-out="o.report_clean_text(shipping.city)"/></t>
                                <t t-if="shipping.state_id">, <span t-out="o.report_clean_text(shipping.state_id.name)"/></t>
                                <t t-if="shipping.country_id">, <span t-out="o.report_clean_text(shipping.country_id.name)"/></t>
                            </div>
                            <div t-if="shipping.phone"><span class="fdc-label">Tel: </span><span t-field="shipping.phone"/></div>
                            <div t-if="shipping.vat"><span class="fdc-label">RUC: </span><span t-field="shipping.vat"/></div>
                        </td>
                        <td>
                            <div class="fdc-label"><span t-out="o.report_clean_text(o.partner_id.name)"/></div>
                            <div>
                                <span t-if="o.partner_id.street" t-out="o.report_clean_text(o.partner_id.street)"/>
                                <t t-if="o.partner_id.street2">, <span t-out="o.report_clean_text(o.partner_id.street2)"/></t>
                                <t t-if="o.partner_id.city">, <span t-out="o.report_clean_text(o.partner_id.city)"/></t>
                                <t t-if="o.partner_id.state_id">, <span t-out="o.report_clean_text(o.partner_id.state_id.name)"/></t>
                                <t t-if="o.partner_id.country_id">, <span t-out="o.report_clean_text(o.partner_id.country_id.name)"/></t>
                            </div>
                            <div t-if="o.partner_id.phone"><span class="fdc-label">Tel: </span><span t-field="o.partner_id.phone"/></div>
                            <div t-if="o.partner_id.vat"><span class="fdc-label">RUC: </span><span t-field="o.partner_id.vat"/></div>
                            <div t-if="o.payment_term_id"><span class="fdc-label">Condicion de pago: </span><span t-out="o.report_clean_text(o.payment_term_id.name)"/></div>
                        </td>
                    </tr>
                </table>

                <table class="fdc-meta">
                    <colgroup>
                        <col style="width:50%;"/>
                        <col style="width:25%;"/>
                        <col style="width:25%;"/>
                    </colgroup>
                    <tr>
                        <td><span class="fdc-label">COMPRADOR</span><br/><span t-out="o.report_clean_text(o.user_id.name)"/></td>
                        <td>
                            <span class="fdc-label">FECHA DE ENTREGA</span><br/>
                            <span t-if="o.date_planned" t-field="o.date_planned" t-options="{'widget':'date'}"/>
                        </td>
                        <td><span class="fdc-label">MONEDA</span><br/><span t-field="o.currency_id"/></td>
                    </tr>
                </table>

                <table class="fdc-lines">
                    <colgroup>
                        <col style="width:50%;"/>
                        <col style="width:9%;"/>
                        <col style="width:13%;"/>
                        <col style="width:8%;"/>
                        <col style="width:9%;"/>
                        <col style="width:11%;"/>
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Descripcion</th>
                            <th class="fdc-number">Cant.</th>
                            <th class="fdc-number">Precio Unit.</th>
                            <th class="fdc-number">Desc.</th>
                            <th class="fdc-number">Impuestos</th>
                            <th class="fdc-number">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line.filtered(lambda line: line.display_type or line.product_qty != 0)" t-as="line">
                            <tr t-if="not line.display_type">
                                <td class="fdc-description"><span t-out="o.report_clean_text(line.name)"/></td>
                                <td class="fdc-number">
                                    <span t-field="line.product_qty"/><br/>
                                    <span t-field="line.product_uom_id"/>
                                </td>
                                <td class="fdc-number">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                </td>
                                <td class="fdc-number"><span t-field="line.discount"/>%</td>
                                <td class="fdc-number">
                                    <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                </td>
                                <td class="fdc-number">
                                    <span t-field="line.price_subtotal"
                                          t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-elif="line.display_type in ('line_section', 'line_subsection')" class="fdc-section-line">
                                <td colspan="6"><strong t-out="o.report_clean_text(line.name)"/></td>
                            </tr>
                            <tr t-else="">
                                <td colspan="6"><em t-out="o.report_clean_text(line.name)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="fdc-total-area">
                    <div class="fdc-totals-wrap">
                        <table class="fdc-totals">
                            <t t-call="purchase.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                            </t>
                        </table>
                    </div>
                </div>

                <div t-if="o.note" class="fdc-notes">
                    <span class="fdc-label">Notas:</span><br/>
                    <span t-field="o.note"/>
                </div>

                <div class="fdc-footer">
                    <table>
                        <tr>
                            <td>servicios@fdc-corporation.com<br/>ventas@fdc-corporation.com</td>
                            <td style="text-align:center;">
                                https://fdc-corporation.com<br/>Pagina <span class="page"/> / <span class="topage"/>
                            </td>
                            <td style="text-align:right;">+51 981 094 754<br/>+51 960 217 220</td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
