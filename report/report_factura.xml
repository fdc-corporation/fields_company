<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_a4_cotizacion" model="report.paperformat">
            <field name="name">FDC Factura A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="disable_shrinking" eval="False"/>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_factura" model="ir.actions.report">
            <field name="name">Factura Electronica</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fields_company.report_factura</field>
            <field name="report_file">fields_company.report_factura</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'%s - %s' % (object.name, object.partner_id.name)</field>
            <field name="paperformat_id" ref="fields_company.paperformat_a4_cotizacion"/>
        </record>

        <template id="report_factura" name="Factura FDC">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <meta charset="utf-8"/>
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                    <t t-set="display_discount" t-value="any(line.discount for line in o.invoice_line_ids)"/>
                    <t t-set="display_taxes" t-value="any(line.tax_ids for line in o.invoice_line_ids)"/>
                    <t t-set="lines_to_report" t-value="o._get_move_lines_to_report()"/>
                    <t t-set="extra_edi_vals" t-value="o._l10n_pe_edi_get_extra_report_values()"/>
                    <t t-set="spot" t-value="o._l10n_pe_edi_get_spot()"/>
                    <t t-set="payment_term_details" t-value="o.payment_term_details"/>

                    <div class="page fdc-invoice">
                        <style>
                            .fdc-invoice {
                                position: relative;
                                min-height: 297mm;
                                padding: 0 5mm 10mm;
                                color: #080808;
                                font-family: Arial, 'DejaVu Sans', sans-serif;
                                font-size: 10px;
                                line-height: 1.2;
                            }
                            .fdc-invoice * { box-sizing: border-box; }
                            .fdc-invoice table { width: 100%; border-collapse: collapse; }
                            .fdc-invoice .invoice-header { height: 27mm; margin: 0 -5mm 2mm; }
                            .fdc-invoice .color-line { display: block; width: 100%; height: 2mm; object-fit: fill; }
                            .fdc-invoice .header-table { width: calc(100% - 10mm); margin: 2mm 5mm 0; table-layout: fixed; }
                            .fdc-invoice .header-table td { padding: 0 2mm; border: 0; vertical-align: top; }
                            .fdc-invoice .company-logo { max-width: 42mm; max-height: 20mm; object-fit: contain; }
                            .fdc-invoice .company-data { text-align: center; font-size: 8.5px; line-height: 1.16; }
                            .fdc-invoice .company-data strong { font-size: 9.5px; }
                            .fdc-invoice .document-data { text-align: center; font-size: 8.5px; }
                            .fdc-invoice .document-title {
                                padding: 1.5mm 1mm;
                                margin-bottom: 1.5mm;
                                background: #e9f1f4;
                                font-size: 9.5px;
                                font-weight: 700;
                            }
                            .fdc-invoice .info-grid { margin-bottom: 3mm; table-layout: fixed; }
                            .fdc-invoice .section-title td,
                            .fdc-invoice .section-title {
                                padding: 1mm 2mm;
                                background: #f0f3f5;
                                font-size: 10.5px;
                                font-weight: 700;
                                text-transform: uppercase;
                            }
                            .fdc-invoice .info-body td {
                                width: 50%;
                                padding: 1.2mm 2mm;
                                vertical-align: top;
                                font-size: 10px;
                                line-height: 1.22;
                            }
                            .fdc-invoice .label { font-weight: 700; }
                            .fdc-invoice .invoice-lines { margin-bottom: 2mm; table-layout: fixed; }
                            .fdc-invoice .invoice-lines th {
                                padding: 1.1mm 1.4mm;
                                background: #f0f3f5;
                                font-size: 10.5px;
                                text-align: left;
                            }
                            .fdc-invoice .invoice-lines td {
                                padding: 1.1mm 1.4mm;
                                font-size: 10px;
                                line-height: 1.2;
                                vertical-align: top;
                            }
                            .fdc-invoice .invoice-lines tbody tr:nth-child(even) { background: #fafafa; }
                            .fdc-invoice .right { text-align: right; white-space: nowrap; }
                            .fdc-invoice .center { text-align: center; }
                            .fdc-invoice .line-section { background: #e8edef !important; font-weight: 700; }
                            .fdc-invoice .summary-grid { margin-top: 2mm; table-layout: fixed; }
                            .fdc-invoice .summary-grid > tbody > tr > td { padding: 0 1.5mm; vertical-align: top; }
                            .fdc-invoice .invoice-qr { width: 28mm; height: 28mm; object-fit: contain; }
                            .fdc-invoice .bank-table { text-align: center; font-size: 8px; }
                            .fdc-invoice .bank-table th,
                            .fdc-invoice .bank-table td { padding: 1mm 1.2mm; border: 0; }
                            .fdc-invoice .bank-table thead { background: #f0f3f5; }
                            .fdc-invoice .bank-table tbody tr:nth-child(odd) { background: #fafafa; }
                            .fdc-invoice .totals-wrap { width: 100%; background: #fff; }
                            .fdc-invoice .totals-wrap table { width: 100% !important; }
                            .fdc-invoice .totals-wrap td,
                            .fdc-invoice .totals-wrap td *,
                            .fdc-invoice .totals-wrap strong,
                            .fdc-invoice .totals-wrap span {
                                padding: 1mm 1.2mm !important;
                                font-size: 9px !important;
                                line-height: 1.18 !important;
                            }
                            .fdc-invoice .amount-words { margin-top: 1.5mm; font-size: 8px; text-align: center; }
                            .fdc-invoice .credit-box {
                                margin-top: 4mm;
                                padding: 3mm 4mm;
                                border: 0.3mm solid #222;
                                background: #fff;
                                font-size: 9px;
                            }
                            .fdc-invoice .credit-box,
                            .fdc-invoice .credit-box * {
                                font-size: 9px !important;
                                line-height: 1.2 !important;
                            }
                            .fdc-invoice .credit-box table { width: 65%; margin-top: 1.5mm; }
                            .fdc-invoice .credit-box td { padding: 1mm 0; }
                            .fdc-invoice .fiscal-box {
                                margin-top: 3mm;
                                padding: 3mm 4mm;
                                border: 0.3mm solid #222;
                                background: #fff;
                                font-size: 9px;
                            }
                            .fdc-invoice .fiscal-box,
                            .fdc-invoice .fiscal-box * {
                                font-size: 9px !important;
                                line-height: 1.2 !important;
                            }
                            .fdc-invoice .fiscal-box table { margin-top: 1.5mm; table-layout: fixed; }
                            .fdc-invoice .fiscal-box td { padding: 1mm 1.5mm; vertical-align: top; }
                            .fdc-invoice .installments { width: 100% !important; margin-top: 2mm !important; }
                            .fdc-invoice .installments th,
                            .fdc-invoice .installments td {
                                padding: 0.9mm 1.5mm !important;
                                border-top: 0.2mm solid #d6dadd;
                                text-align: left;
                            }
                            .fdc-invoice .installments th { background: #f0f3f5; }
                        </style>

                        <div class="invoice-header">
                            <img t-if="o.report_top_line" class="color-line"
                                 t-att-src="image_data_uri(o.report_top_line)" alt=""/>
                            <table class="header-table">
                                <colgroup>
                                    <col style="width:25%;"/>
                                    <col style="width:47%;"/>
                                    <col style="width:28%;"/>
                                </colgroup>
                                <tr>
                                    <td>
                                        <img t-if="o.company_id.logo" class="company-logo"
                                             t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                                    </td>
                                    <td class="company-data">
                                        <strong><span t-field="o.company_id.name"/></strong><br/>
                                        <span t-field="o.company_id.street"/>
                                        <t t-if="o.company_id.city">, <span t-field="o.company_id.city"/></t>
                                        <t t-if="o.company_id.zip">, <span t-field="o.company_id.zip"/></t><br/>
                                        <span t-if="o.company_id.phone">Telefonos: <span t-field="o.company_id.phone"/></span><br/>
                                        <span t-if="o.company_id.website">Pagina Web: <span t-field="o.company_id.website"/></span><br/>
                                        <span t-if="o.company_id.email">Correo Electronico: <span t-field="o.company_id.email"/></span>
                                    </td>
                                    <td class="document-data">
                                        <div class="document-title">
                                            <t t-if="o.move_type == 'out_refund'">Nota de Credito Electronica</t>
                                            <t t-else="">Factura Electronica</t>
                                        </div>
                                        <div><span class="label">RUC: </span><span t-field="o.company_id.vat"/></div>
                                        <div style="margin-top:1mm; font-weight:700;">
                                            <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <table class="info-grid">
                            <tr class="section-title">
                                <td style="width:50%;">Cliente</td>
                                <td style="width:50%;">Datos de factura</td>
                            </tr>
                            <tr class="info-body">
                                <td>
                                    <span class="label" t-field="o.partner_id.name"/><br/>
                                    <span class="label">RUC: </span><span t-field="o.partner_id.vat"/><br/>
                                    <span class="label">Direccion: </span>
                                    <span t-field="o.partner_id.street"/>
                                    <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t><br/>
                                    <span class="label">Distrito: </span>
                                    <span t-if="o.partner_id.l10n_pe_district" t-field="o.partner_id.l10n_pe_district"/><br/>
                                    <span class="label">Provincia: </span>
                                    <span t-if="o.partner_id.city" t-field="o.partner_id.city"/><br/>
                                    <span class="label">Departamento: </span>
                                    <span t-if="o.partner_id.state_id" t-field="o.partner_id.state_id"/><br/>
                                    <span class="label">Telefono: </span><span t-field="o.partner_id.phone"/><br/>
                                    <span class="label">E-mail registrado: </span><span t-field="o.partner_id.email"/>
                                </td>
                                <td>
                                    <span class="label">Fecha de factura: </span>
                                    <span t-field="o.invoice_date" t-options="{'widget':'date'}"/><br/>
                                    <span class="label">Fecha de vencimiento: </span>
                                    <span t-field="o.invoice_date_due" t-options="{'widget':'date'}"/><br/><br/>
                                    <span class="label">Orden de compra: </span><span t-field="o.ref"/><br/>
                                    <span class="label">Guia electronica: </span><span t-field="o.guia_id"/><br/>
                                    <span class="label">Termino de pago: </span><span t-field="o.invoice_payment_term_id"/><br/>
                                    <span class="label">Moneda: </span><span t-field="o.currency_id"/><br/>
                                    <span class="label">Observaciones: </span><span t-field="o.observacion"/>
                                </td>
                            </tr>
                        </table>

                        <table class="invoice-lines">
                            <colgroup>
                                <col style="width:49%;"/>
                                <col style="width:11%;"/>
                                <col style="width:12%;"/>
                                <col t-if="display_discount" style="width:8%;"/>
                                <col t-if="display_taxes" style="width:10%;"/>
                                <col style="width:10%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Descripcion</th>
                                    <th class="right">Cantidad</th>
                                    <th class="right">Precio unitario</th>
                                    <th t-if="display_discount" class="right">Desc.</th>
                                    <th t-if="display_taxes" class="right">Impuesto</th>
                                    <th class="right">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines_to_report" t-as="line">
                                    <tr t-if="line.display_type == 'product'">
                                        <td><span t-field="line.name" style="white-space:pre-line;"/></td>
                                        <td class="right">
                                            <span t-field="line.quantity"/> <span t-field="line.product_uom_id"/>
                                        </td>
                                        <td class="right"><span t-field="line.price_unit"/></td>
                                        <td t-if="display_discount" class="right"><span t-field="line.discount"/>%</td>
                                        <td t-if="display_taxes" class="right">
                                            <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                        </td>
                                        <td class="right">
                                            <span t-field="line.price_subtotal"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr t-elif="line.display_type in ('line_section', 'line_subsection')" class="line-section">
                                        <td t-att-colspan="4 + (1 if display_discount else 0) + (1 if display_taxes else 0)">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-elif="line.display_type == 'line_note'">
                                        <td t-att-colspan="4 + (1 if display_discount else 0) + (1 if display_taxes else 0)">
                                            <em t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="summary-grid">
                            <colgroup>
                                <col style="width:16%;"/>
                                <col style="width:58%;"/>
                                <col style="width:26%;"/>
                            </colgroup>
                            <tr>
                                <td>
                                    <img t-if="o.report_qr_sunat" class="invoice-qr"
                                         t-att-src="image_data_uri(o.report_qr_sunat)"
                                         alt="QR SUNAT"/>
                                </td>
                                <td>
                                    <table class="bank-table">
                                        <thead>
                                            <tr>
                                                <th>Entidad</th><th>Moneda</th><th>Tipo de cuenta</th><th>Numero</th><th>CCI</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr><td>BCP</td><td>Soles</td><td>Corriente</td><td>191-2401343-0-89</td><td>00219100240134308957</td></tr>
                                            <tr><td>BCP</td><td>Dolares</td><td>Corriente</td><td>193-2450819-1-55</td><td>00219300245081915518</td></tr>
                                            <tr><td>Nacion</td><td>Soles</td><td>Detracciones</td><td>00-085-025643</td><td>01808500008502564319</td></tr>
                                            <tr><td>Yape</td><td>Soles</td><td>-</td><td>981 094 754</td><td>-</td></tr>
                                        </tbody>
                                    </table>
                                </td>
                                <td>
                                    <div class="totals-wrap">
                                        <table>
                                            <t t-if="o.tax_totals" t-call="account.document_tax_totals">
                                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                                <t t-set="currency" t-value="o.currency_id"/>
                                            </t>
                                        </table>
                                    </div>
                                    <div t-if="o.company_id.display_invoice_amount_total_words" class="amount-words">
                                        Importe total con letra:
                                        <span t-field="o.amount_total_words"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div t-if="o.tiene_retencion or spot" class="fiscal-box">
                            <t t-if="o.tiene_retencion">
                                <strong>Informacion de la retencion</strong>
                                <table>
                                    <tr>
                                        <td>Base imponible de la retencion:</td>
                                        <td>
                                            <span t-field="o.amount_total"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                        <td>Porcentaje de retencion:</td>
                                        <td><span t-field="o.company_id.procentaje_retencion"/>%</td>
                                        <td>Monto de la retencion:</td>
                                        <td>
                                            <span t-field="o.monto_retencion"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <t t-if="spot">
                                <strong>Operacion sujeta al Sistema de Pago de Obligaciones Tributarias - SPOT</strong>
                                <table>
                                    <tr>
                                        <td>Nro. Cta. Banco de la Nacion:</td>
                                        <td><span t-out="spot.get('payee_financial_account') or ''"/></td>
                                        <td>Porcentaje de detraccion:</td>
                                        <td><span t-out="spot.get('payment_percent') or 0"/>%</td>
                                        <td>Monto de detraccion:</td>
                                        <td>
                                            <span t-out="spot.get('amount') or 0.0"
                                                  t-options="{'widget':'monetary','display_currency':spot.get('currency') or o.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </div>

                        <div class="credit-box">
                            <strong>Informacion del credito:</strong>
                            <t t-set="net_amount" t-value="o.amount_total"/>
                            <t t-if="spot">
                                <t t-set="net_amount" t-value="o.amount_total - (spot.get('amount') or 0.0)"/>
                            </t>
                            <t t-elif="o.tiene_retencion">
                                <t t-set="net_amount" t-value="o.amount_total - (o.monto_retencion or 0.0)"/>
                            </t>
                            <table>
                                <tr>
                                    <td>Total de cuotas</td><td>:</td>
                                    <td><span t-esc="len(payment_term_details) if payment_term_details else 1"/></td>
                                </tr>
                                <tr>
                                    <td>Monto neto pendiente de pago</td><td>:</td>
                                    <td>
                                        <span t-out="net_amount"
                                              t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                            <table t-if="payment_term_details" class="installments">
                                <thead>
                                    <tr>
                                        <th>Nro. de cuota</th>
                                        <th>Fecha de vencimiento</th>
                                        <th>Monto de la cuota</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="payment_term_details" t-as="term">
                                        <td><span t-out="term_index + 1"/></td>
                                        <td><span t-out="term.get('date')" t-options="{'widget':'date'}"/></td>
                                        <td>
                                            <span t-out="term.get('amount') or 0.0"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
